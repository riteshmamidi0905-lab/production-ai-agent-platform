# Copy to .env (never commit .env). Every setting is optional; defaults run fully offline.
AP_DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# AP_REDIS_URL=redis://localhost:6379/0        # cross-worker event fan-out + retrieval cache
# AP_API_KEY=change-me                          # require X-API-Key on /v1/* and /mcp

AP_DEFAULT_PROVIDER=offline                     # offline | openai | ollama | anthropic
AP_PROVIDER_FALLBACKS=["offline"]               # tried in order when the chosen provider fails
# AP_OPENAI_API_KEY=                            # server-side only; works with any OpenAI-compatible base URL
# AP_OPENAI_BASE_URL=https://api.openai.com/v1
# AP_OPENAI_MODEL=gpt-4o-mini
# AP_OLLAMA_BASE_URL=http://localhost:11434/v1  # free local models
# AP_OLLAMA_MODEL=llama3.1
# AP_ANTHROPIC_API_KEY=
# AP_PRICING_JSON={"my-model":[0.5,1.5]}        # USD per 1M tokens (prompt, completion): cost figures are estimates

AP_RUN_BUDGET_USD=1.0                           # hard stop per run
AP_APPROVAL_TIMEOUT_S=300                       # unanswered approvals are denied
AP_ENABLE_FETCH_URL=false
# AP_FETCH_ALLOWLIST=["docs.python.org"]
# AP_MCP_SERVERS=["http://localhost:9000/mcp"]  # import tools from external MCP servers
